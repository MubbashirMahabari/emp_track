<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejected_Leave_Requires_Comment</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Rejected&quot;),
    ISBLANK(Manager_Comment__c)
)</errorConditionFormula>
    <errorDisplayField>Manager_Comment__c</errorDisplayField>
    <errorMessage>Manager comment is required when rejecting a leave request.</errorMessage>
</ValidationRule>
