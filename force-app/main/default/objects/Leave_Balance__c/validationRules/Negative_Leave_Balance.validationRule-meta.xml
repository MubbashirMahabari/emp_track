<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Negative_Leave_Balance</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Annual_Leave__c &lt; 0,
    Sick_Leave__c &lt; 0,
    Casual_Leave__c &lt; 0,
    Used_Leave__c &lt; 0
)</errorConditionFormula>
    <errorMessage>Leave balance values cannot be negative.</errorMessage>
</ValidationRule>
